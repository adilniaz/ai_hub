{
  "name": "local-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, local-first chat interface for Ollama.",
  "scripts": {
    "dev": "vite",
    "training": ".venv-training/bin/python -m uvicorn app:app --app-dir training --host 127.0.0.1 --port 8765",
    "test:training": ".venv-training/bin/python -m unittest training.test_app -v",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "ollama",
    "chat",
    "local-first",
    "webui"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
